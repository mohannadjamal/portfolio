---
import { site } from "../data/site";
---

<section class="experience" id="experience" aria-labelledby="experience-heading">
	<div class="inner">
		<h2 id="experience-heading">Experience</h2>
		<ol class="jobs">
			{site.experience.map((job) => (
				<li class:list={["job", { current: job.current }]}>
					<details open={job.current}>
						<summary>
							<span class="chevron" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
									<path d="M6 9l6 6 6-6" />
								</svg>
							</span>
							<span class="head">
								<span class="title-row">
									<h3>
										{job.role} <span class="sep">·</span>{" "}
										<span class="company">{job.company}</span>
									</h3>
									<span class="period">{job.period}</span>
								</span>
								<span class="context">{job.context}</span>
							</span>
						</summary>
						<ul class="highlights">
							{job.highlights.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</details>
				</li>
			))}
		</ol>
		<div class="education">
			<h3 class="sub-title">Education</h3>
			<p>
				<strong>{site.education.degree}</strong> · {site.education.school} ·{" "}
				<span class="muted">{site.education.year}</span>
			</p>
		</div>
	</div>
</section>

<style>
	.experience {
		padding: var(--space-5) var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.75rem);
		margin: 0 0 var(--space-4);
		color: var(--color-text);
	}

	.jobs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	.job {
		padding-left: var(--space-2);
		border-left: 2px solid var(--color-border);
	}

	.job.current {
		border-left-color: var(--color-accent);
	}

	summary {
		list-style: none;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2);
		align-items: start;
		cursor: pointer;
		border-radius: 8px;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	.chevron {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-top: -0.1rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.chevron svg {
		transform: rotate(-90deg);
		transition: transform 0.2s ease;
	}

	details[open] > summary .chevron svg {
		transform: rotate(0deg);
	}

	summary:hover .chevron {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.head {
		display: block;
		min-width: 0;
	}

	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0 var(--space-2);
	}

	.title-row h3 {
		font-size: 1.125rem;
		margin: 0;
		color: var(--color-text);
	}

	.sep {
		color: var(--color-muted);
		font-weight: 400;
	}

	.company {
		color: var(--color-accent);
	}

	.period {
		font-size: 0.875rem;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.context {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.875rem;
		font-style: italic;
		color: var(--color-muted);
	}

	.highlights {
		list-style: disc;
		margin: var(--space-2) 0 0;
		padding-left: calc(1.75rem + var(--space-2) + 1.1rem);
		max-width: calc(var(--max-width) + 3rem);
		display: grid;
		gap: 0.375rem;
	}

	.highlights li {
		font-size: 0.9375rem;
	}

	.education {
		margin-top: var(--space-5);
	}

	.sub-title {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		margin: 0 0 var(--space-1);
	}

	.education p {
		margin: 0;
	}

	.education strong {
		color: var(--color-text);
	}

	.muted {
		color: var(--color-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.chevron svg {
			transition: none;
		}
	}
</style>
