---
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
	<div class="inner">
		<h2 id="contact-heading">Contact</h2>
		<p class="lead">
			Prefer email? Reach me at
			<a href={`mailto:${site.email}`}>{site.email}</a>.
		</p>
		<p class="lead cv-line">
			<a href={site.cvPdf.href} download={site.cvPdf.fileLabel}>Download CV (PDF)</a>
		</p>
		<ul class="social" aria-label="Social profiles">
			<li>
				<a href={site.social.github} rel="noopener noreferrer">GitHub</a>
			</li>
			<li>
				<a href={site.social.linkedin} rel="noopener noreferrer">LinkedIn</a>
			</li>
		</ul>
	</div>
</section>

<style>
	.contact {
		padding: var(--space-5) var(--space-3) var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.75rem);
		margin: 0 0 var(--space-2);
		color: var(--color-text);
	}

	.lead {
		font-size: 1.0625rem;
		max-width: var(--max-width);
		margin: 0 0 var(--space-3);
	}

	.lead :global(a) {
		font-weight: 600;
	}

	.cv-line {
		margin-bottom: var(--space-4);
	}

	.muted {
		color: var(--color-muted);
		font-weight: 400;
	}

	.social {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.social a {
		font-weight: 600;
		text-decoration: wavy underline;
		text-underline-offset: 0.2em;
	}
</style>
