---
import { site } from "../data/site";
---

<section class="hero" id="top" aria-labelledby="hero-heading">
	<div class="inner">
		<div class="hero-main">
			<p class="eyebrow">Portfolio</p>
			<h1 id="hero-heading">{site.name}</h1>
			<p class="role">{site.role}</p>
			<p class="tagline">{site.tagline}</p>
		</div>
		<div class="actions">
			<a class="cta primary" href="#projects">View projects</a>
			<a class="cta secondary" href={`mailto:${site.email}`}>Email me</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: var(--space-6) var(--space-3) var(--space-5);
	}

	.inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	@media (min-width: 768px) {
		.inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
			align-items: end;
		}

		.hero-main {
			grid-column: 1;
		}

		.actions {
			grid-column: 1 / -1;
		}
	}

	.eyebrow {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-2);
	}

	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 var(--space-2);
		color: var(--color-text);
	}

	.role {
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--color-text);
		margin: 0 0 var(--space-2);
	}

	.tagline {
		font-size: 1.125rem;
		max-width: var(--max-width);
		margin: 0 0 var(--space-4);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.25rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.cta.primary {
		background: var(--color-accent);
		color: var(--color-bg);
		border: 2px solid var(--color-accent);
	}

	.cta.primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
		color: var(--color-bg);
	}

	.cta.secondary {
		background: transparent;
		color: var(--color-text);
		border: 2px solid var(--color-border);
	}

	.cta.secondary:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>
