---
import { site } from "../data/site";
---

<section class="skills" id="skills" aria-labelledby="skills-heading">
	<div class="inner">
		<h2 id="skills-heading">Skills &amp; tools</h2>
		<div class="grid">
			{site.skills.map((category) => (
				<article class="card">
					<h3>{category.name}</h3>
					<div class="groups">
						{category.groups.map((group) => (
							<ul class="pills">
								{group.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						))}
					</div>
					{category.note ? <p class="note">{category.note}</p> : null}
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.skills {
		padding: var(--space-5) var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.75rem);
		margin: 0 0 var(--space-4);
		color: var(--color-text);
	}

	.grid {
		display: grid;
		gap: var(--space-3);
		grid-template-columns: 1fr;
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}

		/* Engineering is the largest category — give it the full row. */
		.card:first-child {
			grid-column: 1 / -1;
		}
	}

	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-3);
	}

	.card h3 {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-accent);
		margin: 0 0 var(--space-2);
	}

	.groups {
		display: grid;
		gap: 0.625rem;
	}

	.pills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.pills li {
		padding: 0.35rem 0.75rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.875rem;
		color: var(--color-text);
	}

	.note {
		margin: var(--space-2) 0 0;
		font-size: 0.875rem;
		color: var(--color-muted);
	}
</style>
